let current = [];
let idx = 0;
let votes = [];

function start() {
  let shuffled = [...DATA].sort(() => 0.5 - Math.random());
  current = shuffled.slice(0, 10);
  idx = 0;
  votes = [];
  showScreen('game');
  renderCard();
}

function renderCard() {
  let item = current[idx];
  document.getElementById('n').innerText = (idx + 1) + ' / 10';
  document.getElementById('pool').innerText = 'Iniciativa ' + item[1];
  document.getElementById('pb').style.width = ((idx / 10) * 100) + '%';
  document.getElementById('tag').innerText = item[1];
  document.getElementById('txt').innerText = item[0];
  document.getElementById('dt').innerText = item[2];
  let why = document.getElementById('why');
  why.innerText = item[4] || '';
  why.style.display = item[4] ? 'block' : 'none';
  document.getElementById('more').innerText = item[5] || '';
  
  let card = document.getElementById('card');
  card.className = 'card';
}

function vote(v) {
  let card = document.getElementById('card');
  let dir = v === 'S' ? 'out-s' : v === 'N' ? 'out-n' : 'out-a';
  card.classList.add(dir);
  votes.push(v);
  setTimeout(() => {
    idx++;
    if (idx < 10) {
      renderCard();
    } else {
      showResults();
    }
  }, 250);
}

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('on'));
  document.getElementById(id).classList.add('on');
}

function showResults() {
  showScreen('res');
  let scores = PARTIES.map((p, i) => {
    let score = 0;
    current.forEach((item, j) => {
      let pv = item[3][i];
      let uv = votes[j];
      if (pv === uv) score += 1;
      else if (uv === 'A' || pv === 'A') score += 0.5;
    });
    return { party: p, score: score, pct: Math.round((score / 10) * 100) };
  });

  scores.sort((a, b) => b.score - a.score);

  let winner = scores[0];
  document.getElementById('win').innerHTML = `<small>Tu partido ideal es</small><div class="big" style="color:${COLORS[winner.party]}">${winner.party}</div><p style="margin-top:10px;color:var(--mute)">Coincidencia del <b>${winner.pct}%</b></p>`;

  let rankHtml = '';
  scores.forEach(s => {
    rankHtml += `<div class="row">
      <div class="dot" style="background:${COLORS[s.party]}"></div>
      <b>${s.party}</b>
      <em>${s.pct}%</em>
      <div class="tr"><i style="width:${s.pct}%;background:${COLORS[s.party]}"></i></div>
    </div>`;
  });
  document.getElementById('rank').innerHTML = rankHtml;

  let detHtml = '';
  current.forEach((item, j) => {
    let uv = votes[j];
    let uvText = uv === 'S' ? 'SÍ' : uv === 'N' ? 'NO' : 'ABSTENCIÓN';
    let uvClass = uv;
    detHtml += `<div class="q">
      <p>${item[0]}</p>
      <span class="you ${uvClass}">Tú: ${uvText}</span>
      <div class="chips">`;
    PARTIES.forEach((p, i) => {
      let pv = item[3][i];
      let match = (pv === uv);
      detHtml += `<span class="chip ${match ? 'm' : ''}">${p}: <u>${pv}</u></span>`;
    });
    detHtml += `</div></div>`;
  });
  document.getElementById('det2').innerHTML = detHtml;
}

function share() {
  if (navigator.share) {
    navigator.share({ title: '¿Votas lo que votan?', url: window.location.href });
  } else {
    navigator.clipboard.writeText(window.location.href);
    alert('Enlace copiado al portapapeles');
  }
}

document.addEventListener('keydown', e => {
  if (!document.getElementById('game').classList.contains('on')) return;
  if (e.key.toUpperCase() === 'S') vote('S');
  if (e.key.toUpperCase() === 'N') vote('N');
  if (e.key.toUpperCase() === 'A') vote('A');
});
</script>
</body>
</html>